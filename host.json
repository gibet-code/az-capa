{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "extensions": {
    "http": {
      "routePrefix": ""
    },
    "durableTask": {
      "hubName": "azcapacity",
      "maxConcurrentActivityFunctions": 25,
      "maxConcurrentOrchestratorFunctions": 20,
      "storageProvider": {
        "partitionCount": 4,
        "maxQueuePollingInterval": "00:00:10",
        "connectionStringName": "AzureDurableFunctionStorage",
        "useTablePartitionManagement": false
      }
    }
  }
}